<?php
function getClientIp(): string
{
    $keys = [
        'HTTP_CF_CONNECTING_IP',
        'HTTP_X_FORWARDED_FOR',
        'HTTP_X_FORWARDED',
        'HTTP_CLIENT_IP',
        'REMOTE_ADDR',
    ];

    foreach ($keys as $key) {
        if (empty($_SERVER[$key])) {
            continue;
        }

        $ipList = explode(',', $_SERVER[$key]);
        $ip = trim($ipList[0]);

        if (filter_var($ip, FILTER_VALIDATE_IP)) {
            return $ip;
        }
    }

    return 'Unknown';
}

function getApproximateLocation(string $ip): array
{
    if ($ip === 'Unknown' || $ip === '127.0.0.1' || $ip === '::1') {
        return ['country' => 'Local', 'city' => 'Localhost', 'region' => 'Local'];
    }

    $url = 'https://ipapi.co/' . rawurlencode($ip) . '/json/';
    $context = stream_context_create([
        'http' => [
            'timeout' => 5,
            'ignore_errors' => true,
        ],
    ]);

    $response = @file_get_contents($url, false, $context);
    if ($response === false) {
        return ['country' => 'Unknown', 'city' => 'Unknown', 'region' => 'Unknown'];
    }

    $data = json_decode($response, true);
    if (!is_array($data)) {
        return ['country' => 'Unknown', 'city' => 'Unknown', 'region' => 'Unknown'];
    }

    return [
        'country' => $data['country_name'] ?? 'Unknown',
        'city' => $data['city'] ?? 'Unknown',
        'region' => $data['region'] ?? 'Unknown',
    ];
}

function convert_ip_to_physical_address($ip) {
    // 1. Skip local IP addresses
    if ($ip === 'Unknown' || $ip === '127.0.0.1' || $ip === '::1') {
        return "Localhost (No physical address)";
    }

    // STEP 1: Get GPS coordinates from the IP address
    $ip_url = "https://ipapi.co{$ip}/json/";
    $ip_response = @file_get_contents($ip_url);
    
    if (!$ip_response) {
        return "Could not look up IP address.";
    }

    $ip_data = json_decode($ip_response, true);
    $lat = $ip_data['latitude'] ?? null;
    $lon = $ip_data['longitude'] ?? null;

    if (!$lat || !$lon) {
        return "Coordinates not found for this IP.";
    }

    // STEP 2: Reverse Geocode the coordinates into a street address
    // OpenStreetMap requires a custom User-Agent header so they know who is asking
    $opts = [
        'http' => [
            'method' => "GET",
            'header' => "User-Agent: MyPHPAddressConverterApp/1.0\r\n"
        ]
    ];
    $context = stream_context_create($opts);
    
    $geo_url = "https://openstreetmap.org{$lat}&lon={$lon}";
    $geo_response = @file_get_contents($geo_url, false, $context);

    if (!$geo_response) {
        return "Could not convert coordinates to street address.";
    }

    $geo_data = json_decode($geo_response, true);

    // Return the full, readable physical street address
    return $geo_data['display_name'] ?? "Address not found.";
}

